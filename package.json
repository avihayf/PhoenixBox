{
  "name": "phoenix-box",
  "private": true,
  "title": "PhoenixBox",
  "description": "PhoenixBox is a powerful multi-container extension specifically designed for security testing and penetration testing workflows with seamless Burp Suite integration.",
  "version": "3.0.0",
  "author": "0xR3dB0mb",
  "bugs": {
    "url": "https://github.com/avihayf/PhoenixBox/issues"
  },
  "dependencies": {
    "@radix-ui/react-switch": "1.1.3",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/stylelint-plugin": "^4.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "chai": "^4.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-no-unsanitized": "^4.1.4",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "html-validate": "^9.1.0",
    "mocha": "^12.0.2",
    "npm-run-all2": "^9.0.3",
    "stylelint": "^16.18.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-order": "^6.0.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.3.0",
    "web-ext": "^10.7.0"
  },
  "homepage": "https://github.com/avihayf/PhoenixBox#readme",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22.18 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avihayf/PhoenixBox.git"
  },
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8"
  },
  "scripts": {
    "build": "node scripts/build-extension.mjs && NO_UPDATE_NOTIFIER=1 web-ext build -s dist/ --overwrite-dest",
    "dev": "node scripts/build-extension.mjs && NO_UPDATE_NOTIFIER=1 web-ext run -s dist/ ${FIREFOX_BIN:+--firefox=\"$FIREFOX_BIN\"}",
    "lint": "npm-run-all lint:*",
    "lint:addon": "node scripts/build-extension.mjs && NO_UPDATE_NOTIFIER=1 web-ext lint -s dist/",
    "lint:css": "stylelint src/css/*.css",
    "lint:html": "html-validate \"src/**/*.html\"",
    "lint:js": "eslint .",
    "package": "npm test && NO_UPDATE_NOTIFIER=1 web-ext build -s dist/ -a . --filename \"phoenixbox-{version}.xpi\" --overwrite-dest",
    "package:source": "rm -f source-code.zip && git archive --format=zip -o source-code.zip HEAD",
    "test": "npm-run-all typecheck lint test:unit",
    "test:unit": "mocha --node-option=disable-warning=MODULE_TYPELESS_PACKAGE_JSON --node-option=disable-warning=ExperimentalWarning 'test/**/*.test.{js,mjs}'",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
